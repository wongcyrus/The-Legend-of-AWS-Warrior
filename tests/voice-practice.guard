rule voice_data_protection {
    Resources.VoicePracticeTable {
        DeletionPolicy == "Retain"
        UpdateReplacePolicy == "Retain"
        Properties.SSESpecification.SSEEnabled == true
        Properties.PointInTimeRecoverySpecification.PointInTimeRecoveryEnabled == true
    }
    Resources.VoiceAudioBucket {
        DeletionPolicy == "Retain"
        UpdateReplacePolicy == "Retain"
        Properties.PublicAccessBlockConfiguration {
            BlockPublicAcls == true
            BlockPublicPolicy == true
            IgnorePublicAcls == true
            RestrictPublicBuckets == true
        }
        Properties.VersioningConfiguration.Status == "Enabled"
        Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm == "AES256"
        Properties.LifecycleConfiguration.Rules[*].ExpirationInDays == 1
    }
}

rule voice_feature_is_explicit {
    Parameters.EnableVoicePractice.Default == "false"
    Resources.VoiceAgentRuntime.Condition == "VoicePracticeEnabled"
    Resources.VoicePracticeFunction.Condition == "VoicePracticeEnabled"
    Resources.VoiceAgentRuntime.Properties.ProtocolConfiguration == "HTTP"
    Resources.VoicePracticeFunction.Properties.ReservedConcurrentExecutions == 5
    Resources.VoicePracticeLogGroup.Properties.RetentionInDays == 14
    Resources.VoicePracticeLogGroup.Properties.KmsKeyId EXISTS
    Resources.VoiceAgentLogGroup.Properties.KmsKeyId EXISTS
    Resources.VoiceLogConfiguratorLogGroup.Properties.KmsKeyId EXISTS
    Resources.VoiceLogKey.Properties.EnableKeyRotation == true
}
