# CloudProjectMarker Configuration
# This file contains centralized configuration for all scripts
# Copy this file to .env.local and customize if needed

# AWS Configuration
AWS_REGION=us-east-1

# CloudFormation Stack Name
# This should match the stack_name in samconfig.toml
STACK_NAME=CloudProjectMarker

# DynamoDB Table Names (will be fetched dynamically from CloudFormation outputs)
# These are fallback values if CloudFormation outputs are not available
# PASSED_TEST_TABLE=CloudProjectMarker-PassedTestTable-XXXXXXX
# FAILED_TEST_TABLE=CloudProjectMarker-FailedTestTable-XXXXXXX
# AWS_ACCOUNT_TABLE=CloudProjectMarker-AwsAccountTable-XXXXXXX
